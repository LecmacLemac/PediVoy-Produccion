[Unit]
Description=PediVoy canonical user service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/.openclaw/workspace-pedivoy/PediVoy
EnvironmentFile=-%h/.config/pedivoy/env
Environment=NODE_ENV=production
Environment=PATH=%h/.nvm/versions/node/v22.22.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/bin/mkdir -p %h/.cache/puppeteer
ExecStartPre=/usr/bin/env PATH=%h/.nvm/versions/node/v22.22.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin PUPPETEER_CACHE_DIR=%h/.cache/puppeteer node scripts/prepare-puppeteer-cache.js
ExecStart=/usr/bin/env PATH=%h/.nvm/versions/node/v22.22.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin PUPPETEER_CACHE_DIR=%h/.cache/puppeteer npm start
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pedivoy
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
