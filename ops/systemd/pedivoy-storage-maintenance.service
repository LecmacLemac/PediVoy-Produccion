[Unit]
Description=PediVoy safe storage maintenance
ConditionPathIsDirectory=%h/.openclaw/workspace-pedivoy/PediVoy

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace-pedivoy/PediVoy
EnvironmentFile=-%h/.config/pedivoy/env
ExecStart=/usr/bin/env WWEBJS_AUTH_ROOT=%h/.openclaw/workspace-pedivoy/PediVoy/.wwebjs_auth WPP_SESSIONS_ROOT=%h/.openclaw/workspace-pedivoy/PediVoy/wpp_sessions PUPPETEER_CACHE_DIR=%h/.cache/puppeteer LEGACY_PUPPETEER_CACHE_DIR=%h/.openclaw/workspace-pedivoy/PediVoy/.puppeteer PEDIVOY_STORAGE_PATH=%h/.openclaw/workspace-pedivoy/PediVoy /usr/bin/node scripts/storage-maintenance.js --apply
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pedivoy-storage-maintenance
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
