[Unit]
Description=PediVoy safe storage maintenance
ConditionPathIsDirectory=%h/.openclaw/workspace-pedivoy/PediVoy

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace-pedivoy/PediVoy
Environment=DISK_PATH=%h/.openclaw/workspace-pedivoy/PediVoy/.wwebjs_auth
Environment=PUPPETEER_CACHE_DIR=%h/.openclaw/workspace-pedivoy/PediVoy/.puppeteer
EnvironmentFile=-%h/.config/pedivoy/env
ExecStart=/usr/bin/node scripts/storage-maintenance.js --apply
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pedivoy-storage-maintenance
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
