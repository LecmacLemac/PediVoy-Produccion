{
  "version": 1,
  "minimumAgeDays": 14,
  "cacheRoots": [
    "$WWEBJS_AUTH_ROOT",
    "$WPP_SESSIONS_ROOT"
  ],
  "cacheDirectoryAllowlist": [
    "Cache",
    "Code Cache",
    "GPUCache",
    "GrShaderCache",
    "ShaderCache",
    "DawnCache"
  ],
  "protectedPathNames": [
    "auth",
    ".wwebjs_auth",
    "wpp_sessions",
    "storage",
    "Local Storage",
    "Session Storage",
    "IndexedDB",
    "uploads",
    "DB",
    "databases",
    "Service Worker"
  ],
  "protectedPathPrefixes": [
    "Singleton"
  ],
  "puppeteer": {
    "cacheRoots": [
      "$PUPPETEER_CACHE_DIR",
      "$LEGACY_PUPPETEER_CACHE_DIR"
    ],
    "expectedVersions": [
      "chrome/linux-153.0.8010.36",
      "chrome-headless-shell/linux-153.0.8010.36",
      "chrome/linux-146.0.7680.76",
      "chrome-headless-shell/linux-146.0.7680.76",
      "chrome/linux-146.0.7680.31",
      "chrome-headless-shell/linux-146.0.7680.31"
    ]
  },
  "diskUsage": {
    "path": "$PEDIVOY_STORAGE_PATH",
    "thresholds": {
      "warning": 80,
      "high": 90,
      "critical": 95
    }
  }
}
