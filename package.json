{
  "name": "me_hidro_render",
  "version": "1.1.0",
  "description": "SaaS Multi-Empresa con Workers de WhatsApp independientes",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prestart": "node scripts/check-node.js",
    "start": "node server.js",
    "predev": "node scripts/check-node.js",
    "dev": "nodemon server.js",
    "worker": "node src/wppWorker.js",
    "init-db": "node initDb.js",
    "test": "echo \"No tests configured\" && exit 0",
    "db:backup": "node backup.js",
    "postinstall": "echo \"Instalando Chromium para Puppeteer (local)\" && if [ -z \"$RENDER\" ]; then PUPPETEER_CACHE_DIR=\"$PWD/.puppeteer\" npx puppeteer browsers install chrome; fi"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.11.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "pdf-img-convert": "^1.2.1",
    "pg": "^8.11.3",
    "puppeteer": "^21.11.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.23.0",
    "zod": "^3.23.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  },
  "keywords": [
    "saas",
    "docker",
    "whatsapp",
    "render"
  ],
  "author": "AguaHidro",
  "license": "ISC"
}