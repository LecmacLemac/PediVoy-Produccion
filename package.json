{
  "name": "me_hidro_render",
  "version": "1.1.0",
  "description": "SaaS Multi-Empresa con Workers de WhatsApp independientes",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prestart": "node scripts/check-node.js",
    "start": "node server.js",
    "predev": "node scripts/check-node.js",
    "dev": "nodemon server.js",
    "worker": "node src/wppWorker.js",
    "init-db": "node initDb.js",
    "test": "NODE_ENV=test node --test tests/**/*.test.js",
    "test:smoke:public": "node scripts/smoke-public.js",
    "test:smoke:postdeploy": "node scripts/smoke-postdeploy.js",
    "test:smoke:security": "node scripts/smoke-security-headers.js",
    "arca:check-credentials": "node scripts/arca-credentials-check.js",
    "ops:data-health": "node scripts/ops-data-health.js",
    "db:backup": "node backup.js",
    "postinstall": "echo \"Postinstall Puppeteer\" && if [ \"$RENDER\" = \"true\" ] || [ \"$CI\" = \"true\" ] || [ \"$PUPPETEER_SKIP_DOWNLOAD\" = \"true\" ]; then echo \"Skipping Puppeteer browser install\"; else PUPPETEER_CACHE_DIR=\"$PWD/.puppeteer\" npx puppeteer browsers install chrome; fi"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.11.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "pdf-img-convert": "^2.0.0",
    "pg": "^8.11.3",
    "puppeteer": "^24.39.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "whatsapp-web.js": "^1.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  },
  "keywords": [
    "saas",
    "docker",
    "whatsapp",
    "render"
  ],
  "author": "AguaHidro",
  "license": "ISC"
}
